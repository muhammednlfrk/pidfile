<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Build args. -->
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>PidFile.NET</AssemblyName>
        <RootNamespace>PidFile.NET</RootNamespace>

        <!-- Package metadata. -->
        <PackageId>PidFile.NET</PackageId>
        <Authors>Muhammed Nilifirka</Authors>
        <Description>Create and manage your PID files.</Description>
        <PackageTags>pidfile;pid;process</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/muhammednlfrk/pidfile-dotnet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Include the README.md file for the NuGet package. -->
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Public API analyzer settings. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="MinVer">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
