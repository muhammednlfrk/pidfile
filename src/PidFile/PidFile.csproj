<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Build args. -->
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>8.0</LangVersion>

        <!-- Package metadata. -->
        <PackageId>PidFile</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Authors>Muhammed Nilifirka</Authors>
        <Description>Crate and manage your pid files.</Description>
        <PackageTags>pidfile;pid;process</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/muhammednlfrk/pidfile</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Include the README.md file for the NuGet package. -->
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Public API analyzer settings. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
